# gym-remote-api - Configuración de Entorno
# Copiar este archivo a .env y ajustar los valores

# ============================================
# ENTORNO
# ============================================
NODE_ENV=development
# Valores posibles: development, production, test

# ============================================
# SERVIDOR
# ============================================
PORT=8080
# Puerto en el que escucha el servidor Bun/Hono
# En producción, usar 8080 y escuchar solo en localhost

# ============================================
# BASE DE DATOS
# ============================================
DATABASE_URL="mysql://user:password@localhost:3306/gym_db"
# Formato: mysql://USER:PASSWORD@HOST:PORT/DATABASE
# Ejemplo producción: "mysql://gym_user:SecurePass123!@127.0.0.1:3306/gym_db"

# ============================================
# SEGURIDAD JWT
# ============================================
JWT_SECRET=change-this-to-a-random-secure-string-minimum-32-characters
# IMPORTANTE: Cambiar por una cadena aleatoria segura
# Generar con: openssl rand -base64 32
# NUNCA compartir este valor ni subirlo a repositorios públicos

JWT_EXPIRES_IN=12h
# Tiempo de expiración de tokens de usuario
# Formatos válidos: 60, "2 days", "10h", "7d"

# ============================================
# LOGGING (Opcional)
# ============================================
LOG_LEVEL=info
# Niveles: error, warn, info, debug, trace

# ============================================
# CORS (Opcional - si se necesita)
# ============================================
# CORS_ORIGIN=https://app.ejemplo.com,https://admin.ejemplo.com
# Lista de orígenes permitidos separados por comas

# ============================================
# PRODUCCIÓN - NOTAS IMPORTANTES
# ============================================
# 1. JWT_SECRET debe ser único y seguro (mínimo 32 caracteres)
# 2. DATABASE_URL debe usar credenciales seguras
# 3. El servidor debe escuchar solo en 127.0.0.1 en producción
# 4. Usar HTTPS via reverse proxy (Nginx/Caddy)
# 5. Nunca exponer este archivo .env públicamente
# 6. Mantener backups del archivo .env de producción de forma segura
