{
  "name": "gym-remote-api",
  "module": "index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "bun --preload ./src/config/tz-preload.ts --watch index.ts",
    "start": "bun --preload ./src/config/tz-preload.ts index.ts",
    "check:tz": "bun --preload ./src/config/tz-preload.ts -e \"console.log('TZ=' + (process.env.TZ || '(unset)'), new Date().toString())\"",
    "check:time": "bun --preload ./src/config/tz-preload.ts scripts/verify-time-contract.ts",
    "migrate:asistencia-pausa": "bun --preload ./src/config/tz-preload.ts scripts/migrate-asistencia-pausa.ts"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^24.10.1",
    "@types/uuid": "^11.0.0",
    "prisma": "^6.19.0"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcryptjs": "^3.0.3",
    "hono": "^4.10.6",
    "jsonwebtoken": "^9.0.2",
    "uuid": "^13.0.0",
    "zod": "^4.1.12"
  }
}
