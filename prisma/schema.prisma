/**
 * ENTIDADES PRINCIPALES
 */

model ClientePeso {
  cliente_peso_id String    @id
  ci              String
  fecha           DateTime
  peso            Float
  is_deleted      Boolean   @default(false)
  created_at      DateTime? @default(now())
  gym_id          String?
  source_device   String?
  version         Int       @default(1)
  updated_at      DateTime  @default(now())
  deleted_at      DateTime?

  cliente Cliente? @relation(fields: [ci], references: [ci])

  @@map("cliente_peso")
}

model Cliente {
  ci               String    @id
  tipo_documento   String    @default("DESCONOCIDO") // CI_CUBANO, PASAPORTE, OTRO, DESCONOCIDO
  // E0 (docs/PLAN_ESTADISTICAS.md §7-bis): día de calendario UTC. Con
  // tipo_documento=CI_CUBANO la DERIVA el servidor de los 11 dígitos y no se
  // acepta del cuerpo; con pasaporte u otro se captura y es obligatoria.
  // Nullable solo por la historia anterior al corte, que la estadística cuenta
  // aparte como «sin fecha» en vez de repartirla.
  fecha_nacimiento DateTime?
  nombres          String
  apellidos        String
  sexo             String
  foto_cliente     Bytes?    @db.LongBlob
  cliente_peso_id  String?
  estatura_cliente Float
  direccion        String?
  telefono         BigInt?
  nacionalidad_id  String
  correo           String?
  objetivo         String?
  id_planes_pago   String?
  id_entrenador    String?
  fecha_inicio     DateTime
  fecha_fin        DateTime
  activo           Boolean
  id_horarios      String?
  referencia_id    String?
  // R5.3: categoría del cliente para el descuento. El default de DB es NUEVO
  // para no romper filas heredadas, pero el alta lo exige explícito (Zod).
  categoria        String    @default("NUEVO") // NUEVO, VIEJO
  is_deleted       Boolean   @default(false)
  created_at       DateTime? @default(now())
  gym_id           String?
  source_device    String?
  version          Int       @default(1)
  updated_at       DateTime  @default(now())
  deleted_at       DateTime?

  nacionalidad Nacionalidad  @relation(fields: [nacionalidad_id], references: [nacionalidad_id])
  plan_pago    PlanesPago?   @relation(fields: [id_planes_pago], references: [id_planes_pago])
  entrenador   Entrenador?   @relation(fields: [id_entrenador], references: [id_entrenador])
  horario      Horario?      @relation(fields: [id_horarios], references: [horario_id])
  referencia   Referencia?   @relation(fields: [referencia_id], references: [referencia_id])
  pesos        ClientePeso[]
  asistencias  Asistencia[]
  pagos        PagoCliente[]
  gym          Gym?          @relation(fields: [gym_id], references: [gym_id])

  @@map("cliente")
}

model Asistencia {
  asistencia_id String    @id
  ci            String
  fecha_salida  DateTime?
  is_deleted    Boolean   @default(false)
  created_at    DateTime? @default(now())
  gym_id        String?
  source_device String?
  version       Int       @default(1)
  updated_at    DateTime  @default(now())
  deleted_at    DateTime?
  // Pausa de permanencia (Mostrador): instante UTC en que inició la pausa
  // vigente (null = no pausado) y milisegundos acumulados de pausas cerradas.
  pausa_inicio  DateTime?
  pausa_ms      Int       @default(0)

  cliente Cliente @relation(fields: [ci], references: [ci])

  @@map("asistencia")
}

model PagoCliente {
  pago_cliente_id String    @id
  ci              String
  fecha           DateTime
  monto_total     Float
  id_entrenador   String?
  id_planes_pago  String
  moneda_id       String
  // R5.3: snapshot del descuento aplicado al cobrar (cliente VIEJO). El monto
  // cobrado vive en `monto_total`; estos tres campos permiten reconstruir el
  // descuento histórico sin perder el precio de lista (igual que tipo_cambio_id
  // congela el recargo R5.1). Null cuando no hubo descuento (cliente NUEVO).
  precio_lista_snapshot    Float?
  descuento_pct_snapshot   String?
  descuento_monto_snapshot Float?
  // Condonación del recargo por mora (docs/RECARGO_MORA.md §6-bis). El recargo
  // se aplica siempre que corresponda; perdonarlo exige motivo y deja rastro.
  // El importe es el que se HABRÍA cobrado, calculado por el servidor.
  recargo_mora_condonado_importe String?
  recargo_mora_condonado_motivo  String?
  recargo_mora_condonado_por     String?
  // R5.6: quién recibió el dinero (docs/PAYMENT_COLLECTOR_ATTRIBUTION.md §5).
  // Nulos solo para historia anterior al corte, que se muestra como
  // «Sin atribuir · histórico»; todo cobro nuevo exige actor revalidado en
  // servidor. `cobrado_por_origen`: LOCAL_USER | SYNCED_USER | REMOTE_USER.
  // No confundir con quien anula (PagoReversion) ni con quien cierra la caja
  // (TesoreriaCierre.cerrado_por_*).
  cobrado_por_user_id         String?
  cobrado_por_nombre_snapshot String?
  cobrado_por_rol_snapshot    String?
  cobrado_por_origen          String?
  is_deleted      Boolean   @default(false)
  created_at      DateTime? @default(now())
  gym_id          String?
  source_device   String?
  version         Int       @default(1)
  updated_at      DateTime  @default(now())
  deleted_at      DateTime?

  cliente    Cliente       @relation(fields: [ci], references: [ci])
  entrenador Entrenador?   @relation(fields: [id_entrenador], references: [id_entrenador])
  plan_pago  PlanesPago    @relation(fields: [id_planes_pago], references: [id_planes_pago])
  moneda     Moneda        @relation(fields: [moneda_id], references: [moneda_id])
  detalles   DetallePago[]
  gym        Gym?          @relation(fields: [gym_id], references: [gym_id])

  @@index([gym_id, cobrado_por_user_id, fecha], map: "idx_pago_cliente_gym_cobrador_fecha")
  @@map("pago_cliente")
}

model DetallePago {
  detalle_pago_id String    @id
  pago_cliente_id String
  tipo_pago_id    String
  moneda_id       String
  cuenta_id       String?
  cantidad        Float
  tipo_cambio_id  String?
  // Recargo por mora congelado (docs/RECARGO_MORA.md). Históricos = null
  // (pre-recargo-mora); sin backfill. Importes como string decimal.
  recargo_mora_modo_snapshot  String?
  recargo_mora_dias_atraso    Int?
  recargo_mora_base           String?
  recargo_mora_importe        String?
  recargo_mora_plan_valor     String?
  recargo_mora_plan_tope      String?
  is_deleted      Boolean   @default(false)
  created_at      DateTime? @default(now())
  gym_id          String?
  source_device   String?
  version         Int       @default(1)
  updated_at      DateTime  @default(now())
  deleted_at      DateTime?

  pago_cliente PagoCliente @relation(fields: [pago_cliente_id], references: [pago_cliente_id])
  tipo_pago    TipoPago    @relation(fields: [tipo_pago_id], references: [tipo_pago_id])
  moneda       Moneda      @relation(fields: [moneda_id], references: [moneda_id])
  cuenta       Cuenta?     @relation(fields: [cuenta_id], references: [cuenta_id])
  tipo_cambio  TipoCambio? @relation(fields: [tipo_cambio_id], references: [tipo_cambio_id])

  @@map("detalle_pago")
}

/**
 * TABLAS DE SINCRONIZACIÓN REMOTA
 */

model SyncLog {
  id           Int      @id @default(autoincrement())
  event_id     String   @unique
  entidad      String
  operacion    String
  entidad_id   String
  gym_id       String?
  device_id    String?
  payload_json String   @db.LongText
