datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

/**
 * MODELOS DE SEGURIDAD / SISTEMA
 */

model User {
  user_id       String    @id
  user_nombre   String
  user_email    String    @unique
  password      String
  role          String    @default("user") // Deprecated: Use roles relation instead
  active        Boolean   @default(true)
  is_deleted    Boolean   @default(false)
  created_at    DateTime? @default(now())
  // Con multi-sede M1, `gym_id` pasa a significar «sede por defecto al entrar»;
  // el permiso real de trabajar en una sede vive en `usuario_sede`.
  gym_id        String?
  /// Dueño de la cadena: el nivel por encima de administración. Puede entrar a
  /// cualquier sede y crear o dar de baja gimnasios, desde escritorio y desde
  /// web. Es global y viaja a TODAS las bases por sincronización, para que se
  /// le reconozca desde la instalación de cualquier sede (decisión del dueño,
  /// 26-07-2026; docs/MULTI_SEDE.md §3).
  es_plataforma Boolean   @default(false)
  source_device String?
  version       Int       @default(1)
  updated_at    DateTime  @default(now())
  deleted_at    DateTime?

  roles Role[] // Many-to-many implicit relation

  @@map("User")
}

/// Quién puede trabajar en qué sede y con qué puesto (docs/MULTI_SEDE.md §3.2).
///
/// Una fila por persona y sede: la misma recepcionista puede estar en Centro
/// por la mañana y en Norte por la tarde, con un puesto distinto en cada una.
/// El identificador se deriva de `user_id|gym_id`, así que las dos bases
/// calculan el mismo valor para el mismo par y la fila puede sincronizarse sin
/// duplicarse.
model UsuarioSede {
  usuario_sede_id String  @id
  user_id         String
  gym_id          String
  rol             String
  activo          Boolean @default(true)

  // Sync Fields
  source_device String?
  version       Int       @default(1)
  is_deleted    Boolean   @default(false)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now())
  deleted_at    DateTime?

  @@unique([user_id, gym_id])
  @@index([gym_id, activo])
  @@map("usuario_sede")
}

model Role {
  id          String       @id @default(uuid())
  name        String       @unique // e.g., 'ADMIN', 'RECEPTIONIST'
  description String?
  permissions Permission[] // Implicit many-to-many
  users       User[]

  // Sync Fields
  gym_id        String?
  source_device String?
  version       Int       @default(1)
  is_deleted    Boolean   @default(false)
  created_at    DateTime? @default(now())
  updated_at    DateTime  @default(now())
  deleted_at    DateTime?

  @@map("roles")
}

model Permission {
  id          String  @id @default(uuid())
  action      String  @unique // e.g., 'users.read', 'clients.create'
  description String?
  roles       Role[]

  // Sync Fields
  gym_id        String?
  source_device String?
  version       Int       @default(1)
  is_deleted    Boolean   @default(false)
  created_at    DateTime? @default(now())
  updated_at    DateTime  @default(now())
  deleted_at    DateTime?

  @@map("permissions")
}

model Gym {
  gym_id        String    @id
  codigo        String    @unique
  nombre        String
  direccion     String?
  ciudad        String?
  provincia     String?
  pais          String?
  codigo_postal String?
  timezone      String?   @default("Etc/UTC")
  activo        Boolean   @default(true)
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now())
  deleted_at    DateTime?

  devices  Device[]
  clientes Cliente[]
  pagos    PagoCliente[]

  @@map("gym")
}

model Device {
  device_id     String    @id
  gym_id        String
  gym           Gym       @relation(fields: [gym_id], references: [gym_id])
  nombre        String
  tipo          String    @default("BACKEND_OFFLINE")
  descripcion   String?
  ultima_ip     String?
  last_seen_at  DateTime?
  // activo       Boolean  @default(true) -- Removed in favor of is_active
  secret_key    String    @default("default_secret")
  is_active     Boolean   @default(true)
  last_login_at DateTime?
  created_at    DateTime  @default(now())
  updated_at    DateTime  @default(now())
  deleted_at    DateTime?

  @@map("device")
}

/**
 * TABLAS GLOBALES (NO POR GIMNASIO)
 */

model Moneda {
  moneda_id     String    @id
  moneda_nombre String
  codigo        String    @unique
  simbolo       String?
  imagen        Bytes?    @db.LongBlob
  is_deleted    Boolean   @default(false)
  created_at    DateTime? @default(now())
  version       Int       @default(1)
  updated_at    DateTime  @default(now())
  deleted_at    DateTime?

  planes_pago         PlanesPago[]
  cuentas             Cuenta[]
  pagos               PagoCliente[]
  detalles_pago       DetallePago[]
  tipos_cambio_base   TipoCambio[]  @relation("MonedaBase")
  tipos_cambio_target TipoCambio[]  @relation("MonedaTarget")

  @@map("monedas")
}

model Nacionalidad {
  nacionalidad_id     String    @id
  nacionalidad_nombre String
  codigo_iso          String    @unique
  bandera             Bytes?    @db.LongBlob
  is_deleted          Boolean   @default(false)
  created_at          DateTime? @default(now())
  version             Int       @default(1)
  updated_at          DateTime  @default(now())
  deleted_at          DateTime?

  clientes Cliente[]

  @@map("nacionalidades")
}

model TipoPago {
  tipo_pago_id     String    @id
  nombre_tipo_pago String
  codigo           String? // Pending mandatory migration
  activo           Boolean   @default(true)
  is_deleted       Boolean   @default(false)
  created_at       DateTime? @default(now())
  version          Int       @default(1)
  updated_at       DateTime  @default(now())
  deleted_at       DateTime?

  detalles_pago DetallePago[]

  @@map("tipo_pago")
}

model TipoCambio {
  tipo_cambio_id   String    @id
  moneda_id_base   String
  moneda_id_target String
  exchange_rate    Float
  recargos_json    String?
  fecha_inicio     DateTime
  fecha_expiracion DateTime?
  activo           Boolean   @default(true)
  is_deleted       Boolean   @default(false)
  created_at       DateTime? @default(now())
  version          Int       @default(1)
  updated_at       DateTime  @default(now())
  deleted_at       DateTime?

  detalles      DetallePago[]
  moneda_base   Moneda        @relation("MonedaBase", fields: [moneda_id_base], references: [moneda_id])
  moneda_target Moneda        @relation("MonedaTarget", fields: [moneda_id_target], references: [moneda_id])

  @@map("tipo_cambio")
}

model ConfiguracionSistema {
  configuracion_id String    @id
  clave            String
  valor            String    @db.Text
  descripcion      String?
  gym_id           String    @default("GLOBAL")
  is_deleted       Boolean   @default(false)
  created_at       DateTime? @default(now())
  version          Int       @default(1)
  updated_at       DateTime  @default(now())
  deleted_at       DateTime?

  @@unique([clave, gym_id])
  @@map("configuracion_sistema")
}

model Referencia {
  referencia_id     String    @id
  nombre_referencia String
  is_deleted        Boolean   @default(false)
  created_at        DateTime? @default(now())
  version           Int       @default(1)
  updated_at        DateTime  @default(now())
  deleted_at        DateTime?

  clientes Cliente[]

  @@map("referencia")
}

/**
 * TABLAS POR GIMNASIO
 */

model Horario {
  horario_id     String    @id
  nombre_horario String
  hora_inicio    Int
  hora_fin       Int
  is_deleted     Boolean   @default(false)
  created_at     DateTime? @default(now())
  gym_id         String?
  source_device  String?
  version        Int       @default(1)
  updated_at     DateTime  @default(now())
  deleted_at     DateTime?

  clientes Cliente[]

  @@map("horario")
}

model PlanesPago {
  id_planes_pago            String    @id
  nombre_plan_pago          String?
  importe_plan_pago         Float
  duracion_plan_pago        Int
  activo                    Boolean   @default(true)
  moneda_id                 String
  incluye_entrenador        Boolean   @default(false)
  comision_entrenador_tipo  String    @default("NONE") // NONE, PERCENTAGE, FIXED_AMOUNT
  comision_entrenador_valor Float?
  // R5.2: indica si el plan admite pago por cuotas. El esquema real vive en
  // plan_cuota_esquema. false (por defecto) = pago único, comportamiento actual.
  acepta_cuotas             Boolean   @default(false)
  // R5.3: código corto para recepción (PMV, PMN, TCN...). Campo libre, sin
  // unicidad forzada; la cuota añade sufijos /1, /2, /3 desde el esquema R5.2.
  codigo                    String?
  // R5.3: precio fijo para cliente VIEJO. Si es null, se aplica el % global
  // (DESCUENTO_CLIENTE_VIEJO_PCT); si está seteado, anula el % para este plan.
  precio_viejo_excepcion    Float?
  // Recargo por mora (docs/RECARGO_MORA.md). El administrador define, por plan,
  // uno de tres modos que se cobra al pagar con atraso. null/activo=false = sin
  // recargo. Importes como string decimal, no Float.
  recargo_mora_modo         String?   // null | PORCENTAJE | MONTO_FIJO | POR_DIA
  recargo_mora_valor        String?   // pct (0-100) o monto diario/fijo
  recargo_mora_tope         String?   // solo POR_DIA; null = sin tope
  recargo_mora_activo       Boolean   @default(false)
  is_deleted                Boolean   @default(false)
  created_at                DateTime? @default(now())
  gym_id                    String?
  source_device             String?
  version                   Int       @default(1)
  updated_at                DateTime  @default(now())
  deleted_at                DateTime?

  moneda   Moneda        @relation(fields: [moneda_id], references: [moneda_id])
  clientes Cliente[]
  pagos    PagoCliente[]

  @@map("planes_pago")
}

// Contrato histórico de servicio. `Cliente` conserva temporalmente el plan y
// las fechas vigentes como proyección, pero el historial vive aquí.
model MembresiaCliente {
  membresia_id             String    @id
  ci                       String
  id_planes_pago           String
  id_entrenador            String?
  plan_nombre_snapshot     String
  precio_snapshot          Decimal   @db.Decimal(18, 2)
  moneda_id                String
  duracion_dias_snapshot   Int
  fecha_inicio             DateTime
  fecha_fin                DateTime
  estado                   String    @default("PENDIENTE_PAGO") // PENDIENTE_PAGO, ACTIVA, PAUSADA, VENCIDA, CANCELADA
  origen                   String    @default("ALTA") // ALTA, RENOVACION, CAMBIO, REACTIVACION, MIGRACION_ESTADO_ACTUAL
  importe_pagado           Decimal   @default(0) @db.Decimal(18, 2)
  activada_at              DateTime?
  reconstruida             Boolean   @default(false)
  confianza_reconstruccion String?
  is_deleted               Boolean   @default(false)
  created_at               DateTime? @default(now())
  gym_id                   String
  source_device            String?
  version                  Int       @default(1)
  updated_at               DateTime  @default(now())
  deleted_at               DateTime?

  @@index([ci, estado, fecha_fin], map: "idx_memb_cliente_ci_estado_fin")
  @@index([gym_id, estado, fecha_fin], map: "idx_memb_cliente_gym_estado_fin")
  @@index([id_planes_pago, estado], map: "idx_memb_cliente_plan_estado")
  @@map("membresia_cliente")
}

// Intervalo auditable de congelación de una membresía. Las fechas efectivas
// son días de calendario UTC; *_at son instantes UTC del reloj confiable.
model MembresiaPausa {
  pausa_id                 String    @id
  membresia_id             String
  fecha_pausa              DateTime
  fecha_reanudacion        DateTime?
  fecha_fin_anterior       DateTime
  fecha_fin_recalculada    DateTime?
  dias_restantes_snapshot  Int
  motivo                   String
  estado                   String    @default("ACTIVA") // ACTIVA, REANUDADA, CANCELADA
  activa_clave             String?   @unique(map: "uq_memb_pausa_activa")
  pausada_at               DateTime
  reanudada_at             DateTime?
  registrada_por_user_id   String?
  reanudada_por_user_id    String?
  reanudacion_operacion_id String?   @unique(map: "uq_memb_pausa_resume_op")
  is_deleted               Boolean   @default(false)
  created_at               DateTime? @default(now())
  gym_id                   String
  source_device            String?
  version                  Int       @default(1)
  updated_at               DateTime  @default(now())
  deleted_at               DateTime?

  @@index([membresia_id, estado], map: "idx_memb_pausa_memb_estado")
  @@index([gym_id, estado, fecha_pausa], map: "idx_memb_pausa_gym_estado_fecha")
  @@map("membresia_pausa")
}

// Solicitud protegida que no altera la vigencia hasta que otra cuenta de
// administración registra una decisión. `pendiente_clave` impide dos
// solicitudes abiertas para la misma membresía.
model MembresiaSolicitud {
  solicitud_id                   String    @id
  membresia_id                   String
  ci                             String
  tipo                           String // PAUSAR, REANUDAR
  motivo                         String
  estado                         String    @default("PENDIENTE") // PENDIENTE, EN_DECISION (transaccional), APROBADA, RECHAZADA, CANCELADA
  pendiente_clave                String?   @unique(map: "uq_memb_sol_pendiente")
  fecha_efectiva_solicitada      DateTime
  fecha_efectiva_aplicada        DateTime?
  dias_restantes_estimados       Int
  dias_restantes_aplicados       Int?
  fecha_fin_estimada             DateTime?
  fecha_fin_resultante           DateTime?
  solicitada_por_user_id         String
  solicitada_por_nombre_snapshot String
  solicitada_at                  DateTime
  decidida_por_user_id           String?
  decidida_por_nombre_snapshot   String?
  decision_motivo                String?
  decision_operacion_id          String?   @unique(map: "uq_memb_sol_decision_op")
  decidida_at                    DateTime?
  is_deleted                     Boolean   @default(false)
  created_at                     DateTime? @default(now())
  gym_id                         String
  source_device                  String?
  version                        Int       @default(1)
  updated_at                     DateTime  @default(now())
  deleted_at                     DateTime?

  @@index([gym_id, estado, solicitada_at], map: "idx_memb_sol_gym_estado_fecha")
  @@index([membresia_id, estado], map: "idx_memb_sol_memb_estado")
  @@index([ci, estado, solicitada_at], map: "idx_memb_sol_ci_estado_fecha")
  @@map("membresia_solicitud")
}

// Bitácora operativa append-only de contactos por renovación. Nunca activa una
// membresía ni sustituye la evidencia financiera del pago.
// Catálogo administrable de motivos de baja (docs/PLAN_ESTADISTICAS.md §7-ter).
// Los diez base (es_sistema=true) se siembran por gimnasio y no se pueden
// borrar; el operador añade y retira los suyos sin tocar la aplicación.
// Desactivar oculta el motivo de gestiones NUEVAS y no altera la historia;
// borrar solo se permite si nunca se usó.
model MotivoBaja {
  motivo_baja_id String    @id
  gym_id         String
  nombre         String
  codigo         String?
  orden          Int       @default(0)
  activo         Boolean   @default(true)
  es_sistema     Boolean   @default(false)
  is_deleted     Boolean   @default(false)
  created_at     DateTime  @default(now())
  source_device  String?
  version        Int       @default(1)
  updated_at     DateTime  @default(now())
  deleted_at     DateTime?

  @@unique([gym_id, nombre], map: "uq_motivo_baja_nombre")
  @@index([gym_id, activo, orden], map: "idx_motivo_baja_gym_activo")
  @@map("motivo_baja")
}

model RetencionGestion {
  gestion_id                     String    @id
  membresia_id                   String
  ci                             String
  resultado                      String // CONTACTADO, PROMESA_PAGO, NO_LOCALIZADO, NO_DESEA_RENOVAR
  canal                          String // LLAMADA, WHATSAPP, SMS, PRESENCIAL, OTRO
  // Motivo codificado (§7-ter). Obligatorio con NO_DESEA_RENOVAR, opcional con
  // CONTACTADO y PROMESA_PAGO —ahí es aviso temprano, no baja— y no aplica a
  // NO_LOCALIZADO, que ya es una categoría de baja por sí misma. Se agrupa por
  // el ID para que renombrar no parta la serie; el snapshot conserva el nombre
  // vigente al registrar.
  motivo_baja_id                 String?
  motivo_nombre_snapshot         String?
  nota                           String?
  promesa_fecha                  DateTime?
  proxima_gestion_fecha          DateTime?
  registrada_por_user_id         String
  registrada_por_nombre_snapshot String
  registrada_at                  DateTime
  is_deleted                     Boolean   @default(false)
  created_at                     DateTime? @default(now())
  gym_id                         String
  source_device                  String?
  version                        Int       @default(1)
  updated_at                     DateTime  @default(now())
  deleted_at                     DateTime?

  @@index([gym_id, ci, registrada_at], map: "idx_ret_gest_gym_ci_fecha")
  @@index([gym_id, proxima_gestion_fecha, resultado], map: "idx_ret_gest_gym_proxima_result")
  @@index([membresia_id, registrada_at], map: "idx_ret_gest_memb_fecha")
  @@map("retencion_gestion")
}

// Historial no solapado de quién presta el servicio de entrenamiento.
model MembresiaEntrenadorAsignacion {
  asignacion_id String    @id
  membresia_id  String
  id_entrenador String
  fecha_inicio  DateTime
  fecha_fin     DateTime?
  estado        String    @default("PENDIENTE") // PENDIENTE, ACTIVA, CERRADA, CANCELADA
  motivo_cierre String?
  is_deleted    Boolean   @default(false)
  created_at    DateTime? @default(now())
  gym_id        String
  source_device String?
  version       Int       @default(1)
  updated_at    DateTime  @default(now())
  deleted_at    DateTime?

  @@index([membresia_id, estado], map: "idx_memb_asig_memb_estado")
  @@index([id_entrenador, estado, fecha_inicio], map: "idx_memb_asig_ent_estado_inicio")
  @@map("membresia_entrenador_asignacion")
}

// Aplicación explícita de un cobro a una contratación. Permite varios abonos
// sin extender varias veces el mismo periodo.
model PagoMembresiaAplicacion {
  aplicacion_id   String    @id
  pago_cliente_id String
  membresia_id    String
  moneda_id       String
  monto_aplicado  Decimal   @db.Decimal(18, 2)
  is_deleted      Boolean   @default(false)
  created_at      DateTime? @default(now())
  gym_id          String
  source_device   String?
  version         Int       @default(1)
  updated_at      DateTime  @default(now())
  deleted_at      DateTime?

  @@unique([pago_cliente_id, membresia_id], map: "uq_pago_memb_pago_memb")
  @@index([membresia_id, is_deleted], map: "idx_pago_memb_memb_deleted")
  @@map("pago_membresia_aplicacion")
}

// Evidencia append-only de la reversión coordinada de un cobro. El ID de la
// reversión coincide de forma determinista con el pago para hacer converger
// reintentos locales/remotos sin duplicar la operación.
model PagoReversion {
  reversion_id                   String    @id
  pago_cliente_id                String    @unique(map: "uq_pago_rev_pago")
  operacion_id                   String    @unique(map: "uq_pago_rev_operacion")
  tipo                           String    @default("ANULACION") // ANULACION; REEMBOLSO queda reservado para Tesorería
  motivo                         String    @db.Text
  ci                             String
  membresia_id                   String?
  monto_total                    Float
  moneda_id                      String
  registrada_por_user_id         String
  registrada_por_nombre_snapshot String
  registrada_at                  DateTime
  resumen_json                   String    @db.LongText
  is_deleted                     Boolean   @default(false)
  created_at                     DateTime? @default(now())
  gym_id                         String
  source_device                  String?
  version                        Int       @default(1)
  updated_at                     DateTime  @default(now())
  deleted_at                     DateTime?

  @@index([gym_id, registrada_at], map: "idx_pago_rev_gym_fecha")
  @@index([ci, registrada_at], map: "idx_pago_rev_ci_fecha")
  @@map("pago_reversion")
}

model EntrenadorComisionRegla {
  regla_id       String    @id
  id_entrenador  String?
  id_planes_pago String
  tipo_calculo   String // PERCENTAGE, FIXED_AMOUNT
  valor_calculo  Float
  activo         Boolean   @default(true)
  fecha_inicio   DateTime  @default(now())
  fecha_fin      DateTime?
  is_deleted     Boolean   @default(false)
  created_at     DateTime? @default(now())
  gym_id         String?
  source_device  String?
  version        Int       @default(1)
  updated_at     DateTime  @default(now())
  deleted_at     DateTime?

  @@index([id_planes_pago, id_entrenador, activo])
  @@map("entrenador_comision_regla")
}

model EntrenadorComisionDevengo {
  devengo_id             String    @id
  pago_cliente_id        String
  membresia_id           String?
  fuente_tipo            String    @default("PAGO_CLIENTE") // PAGO_CLIENTE, CREDITO_MEMBRESIA
  fuente_id              String?
  id_entrenador          String
  id_planes_pago         String
  moneda_id              String
  monto_base             Float
  tipo_calculo           String
  valor_calculo          Float
  monto_total            Float
  cuotas_total           Int
  cuotas_pagadas         Int       @default(0)
  estado                 String    @default("PENDIENTE") // PENDIENTE, PAGADO, ANULADO
  fecha_inicio_servicio  DateTime
  fecha_fin_servicio     DateTime?
  perfil_compensacion_id String?
  modalidad_compensacion String?
  metodo_devengo         String?
  frecuencia_desembolso  String?
  dia_corte              Int?
  cuenta_preferida_id    String?
  is_deleted             Boolean   @default(false)
  created_at             DateTime? @default(now())
  gym_id                 String?
  source_device          String?
  version                Int       @default(1)
  updated_at             DateTime  @default(now())
  deleted_at             DateTime?

  @@index([pago_cliente_id])
  @@index([membresia_id, estado], map: "idx_ent_com_dev_memb_estado")
  @@index([fuente_tipo, fuente_id], map: "idx_ent_com_dev_fuente")
  @@index([id_entrenador, estado])
  @@map("entrenador_comision_devengo")
}

model EntrenadorCompensacionPerfil {
  perfil_id             String    @id
  id_entrenador         String
  modalidad             String // COMISION, FIJO, MIXTO
  metodo_devengo        String // PERIODOS_IGUALES, DIAS_SERVICIO
  frecuencia_desembolso String // DIARIA, SEMANAL, QUINCENAL, MENSUAL, EXTRAORDINARIA
  dia_corte             Int?
  monto_fijo            Decimal?  @db.Decimal(18, 2)
  moneda_id             String?
  cuenta_preferida_id   String?
  activo                Boolean   @default(true)
  fecha_inicio          DateTime  @db.DateTime(3)
  fecha_fin             DateTime? @db.DateTime(3)
  notas                 String?   @db.Text
  is_deleted            Boolean   @default(false)
  created_at            DateTime  @default(now()) @db.DateTime(3)
  gym_id                String
  source_device         String?
