// --- R4.6: GASTOS DEVENGADOS GOBERNADOS ---
// Gastos reales del gimnasio (alquiler, electricidad, limpieza, mantenimiento,
// proveedores) gobernados por un mes de pertenencia distinto de la fecha de
// pago. El devengo reconoce a qué mes pertenece el gasto; el libro de
// Tesorería refleja cuándo salió el dinero. Siempre separado por moneda.

model GastoCategoria {
  categoria_id  String    @id
  gym_id        String
  nombre        String
  naturaleza    String    @default("OPERATIVO") // OPERATIVO, ADMINISTRATIVO, COSTO_VENTAS
  es_sistema    Boolean   @default(false)
  is_deleted    Boolean   @default(false)
  created_at    DateTime  @default(now())
  source_device String?
  version       Int       @default(1)
  updated_at    DateTime  @default(now())
  deleted_at    DateTime?

  @@unique([gym_id, nombre], map: "uq_gasto_categoria_nombre")
  @@index([gym_id, naturaleza], map: "idx_gasto_categoria_naturaleza")
  @@map("gasto_categoria")
}

model GastoProveedor {
  proveedor_id           String    @id
  gym_id                 String
  nombre                 String
  documento              String?
  cuenta_pago_default_id String?
  is_deleted             Boolean   @default(false)
  created_at             DateTime  @default(now())
  source_device          String?
  version                Int       @default(1)
  updated_at             DateTime  @default(now())
  deleted_at             DateTime?

  @@unique([gym_id, documento], map: "uq_gasto_proveedor_documento")
  @@index([gym_id, nombre], map: "idx_gasto_proveedor_nombre")
  @@map("gasto_proveedor")
}

model GastoGobernado {
  gasto_id                String    @id
  gym_id                  String
  categoria_id            String
  proveedor_id            String?
  moneda_id               String
  descripcion             String
  monto                   Decimal
  periodo_pertenencia_mes String // AAAA-MM, mes al que pertenece el gasto
  fecha_pago              DateTime? // cuándo salió el dinero (nullable hasta pagar)
  fecha_programada        DateTime // cuándo se espera pagar
  recurrente_id           String? // plantilla que lo generó (null si es manual)
  metodo_devengo          String    @default("MES_PERTENENCIA")
  estado                  String    @default("PENDIENTE") // PENDIENTE, PARCIAL, PAGADO, ANULADO
  pagado_acumulado        Decimal   @default(0)
  comprobante_referencia  String?
  // Actor congelado (paridad R5.6): quién lo registró viaja dentro del evento.
  // `registrada_por_origen`: LOCAL_USER | SYNCED_USER | REMOTE_USER. Un
  // LOCAL_USER puede no tener nunca fila aquí y aun así ser el autor, así que
  // la subida valida el actor congelado y no exige fila en `User`.
  registrada_por_user_id  String
  registrada_por_nombre_snapshot String? @db.VarChar(191)
  registrada_por_rol_snapshot    String? @db.VarChar(80)
  registrada_por_origen          String? @db.VarChar(32)
  formula_snapshot_json   String    @db.LongText
  is_deleted              Boolean   @default(false)
  created_at              DateTime  @default(now())
  source_device           String?
  version                 Int       @default(1)
  updated_at              DateTime  @default(now())
  deleted_at              DateTime?

  // Una plantilla genera como mucho un gasto por mes de pertenencia: es lo que
  // hace idempotente la generación aunque se pulse dos veces.
  @@unique([recurrente_id, periodo_pertenencia_mes], map: "uq_gasto_recurrente_mes")
  @@index([gym_id, periodo_pertenencia_mes, estado], map: "idx_gasto_mes_estado")
  @@index([gym_id, categoria_id], map: "idx_gasto_categoria")
  @@index([gym_id, proveedor_id], map: "idx_gasto_proveedor")
  @@map("gasto_gobernado")
}

// R4.7 — Plantilla de gasto recurrente. No es un gasto: es la instrucción de
// crear uno cada mes (alquiler, electricidad, limpieza). El gasto real solo
// existe cuando se genera, para que nadie devengue un mes que aún no ocurrió.
model GastoRecurrente {
  recurrente_id  String    @id
  gym_id         String
  categoria_id   String
  proveedor_id   String?
  moneda_id      String
  descripcion    String
  monto          Decimal
  // Día del mes de la fecha programada de pago. Se limita a 1-28 para que
  // exista en todos los meses; febrero no debe cambiar el comportamiento.
  dia_programado Int       @default(1)
  mes_inicio     String // AAAA-MM, primer mes que genera
  mes_fin        String? // AAAA-MM inclusive; null = sin fecha de término
  activo         Boolean   @default(true)
  notas          String?
  is_deleted     Boolean   @default(false)
  created_at     DateTime  @default(now())
  source_device  String?
  version        Int       @default(1)
  updated_at     DateTime  @default(now())
  deleted_at     DateTime?

  @@index([gym_id, activo], map: "idx_gasto_recurrente_activo")
  @@index([gym_id, categoria_id], map: "idx_gasto_recurrente_categoria")
  @@map("gasto_recurrente")
}

model GastoGobernadoAplicacion {
  aplicacion_id  String    @id
  gasto_id       String
  movimiento_id  String
  monto_aplicado Decimal
  estado         String    @default("APLICADA") // APLICADA, REVERSADA
  aplicada_at    DateTime
  is_deleted     Boolean   @default(false)
  created_at     DateTime  @default(now())
  gym_id         String
  source_device  String?
  version        Int       @default(1)
  updated_at     DateTime  @default(now())
  deleted_at     DateTime?

  @@unique([gasto_id, movimiento_id], map: "uq_gasto_aplicacion_mov")
  @@index([gasto_id, estado], map: "idx_gasto_aplicacion_estado")
  @@map("gasto_gobernado_aplicacion")
}

// --- R5.2: CALENDARIO DE CUOTAS DEL CLIENTE EN PLANES LARGOS ---
// Un plan largo (trimestral, semestral, anual) puede pagarse por cuotas con
// calendario asimétrico. El plan sigue siendo uno; las cuotas son su forma de
// pago. El esquema define cuántas cuotas, su importe y el tramo que cada una
// cubre. La suma de dias_cobertura debe igualar duracion_plan_pago.

model PlanCuotaEsquema {
  esquema_id     String    @id
  gym_id         String
  plan_id        String
  numero_cuota   Int
  importe        Decimal
  dias_cobertura Int
  orden          Int
  is_deleted     Boolean   @default(false)
  created_at     DateTime  @default(now())
  source_device  String?
  version        Int       @default(1)
  updated_at     DateTime  @default(now())
  deleted_at     DateTime?

  @@unique([plan_id, numero_cuota], map: "uq_plan_cuota_numero")
  @@index([gym_id, plan_id], map: "idx_plan_cuota_plan")
  @@map("plan_cuota_esquema")
}

model MembresiaCuota {
  cuota_instancia_id     String    @id
  gym_id                 String
  membresia_id           String
  numero_cuota           Int
  importe                Decimal
  dias_cobertura         Int
  fecha_exigible         DateTime
  fecha_cobertura_inicio DateTime
  fecha_cobertura_fin    DateTime
  estado                 String    @default("PENDIENTE") // PENDIENTE, PAGADA, ANTICIPADA, ANULADA
  fecha_pagada           DateTime?
  pago_detalle_id        String?
  is_deleted             Boolean   @default(false)
  created_at             DateTime  @default(now())
  source_device          String?
  version                Int       @default(1)
  updated_at             DateTime  @default(now())
  deleted_at             DateTime?

  @@unique([membresia_id, numero_cuota], map: "uq_membresia_cuota_numero")
  @@index([gym_id, estado, fecha_exigible], map: "idx_membresia_cuota_mora")
  @@index([membresia_id, numero_cuota], map: "idx_membresia_cuota_orden")
  @@map("membresia_cuota")
}

model AvisoAdministracion {
  aviso_id      String    @id
  gym_id        String
  tipo          String
  referencia_id String?
  mensaje       String
  actor_user_id String?
  actor_nombre  String?
  leido         Boolean   @default(false)
  is_deleted    Boolean   @default(false)
  created_at    DateTime  @default(now())
  source_device String?
  version       Int       @default(1)
  updated_at    DateTime  @default(now())
  deleted_at    DateTime?

  @@index([gym_id, leido, created_at], map: "idx_aviso_admin_bandeja")
  @@map("aviso_administracion")
}
