  timestamp DateTime @default(now())
  level     String // INFO, WARN, ERROR
  category  String // AUTH, RATE_LIMIT, ADMIN_ACTION, JWT
  action    String // LOGIN_SUCCESS, LOGIN_FAILED, etc.
  ip        String?
  userId    String?
  deviceId  String?
  gymId     String?
  success   Boolean
  metadata  String?  @db.LongText // JSON stringified

  @@map("security_audit_log")
